// Realcorp — multi-tenant PropTech core schema (Sprint 0+)

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ——— Auth.js (Prisma adapter) ———

model User {
  id               String    @id @default(cuid())
  name             String?
  email            String?   @unique
  emailVerified    DateTime?
  image            String?
  passwordHash     String?
  isPlatformAdmin  Boolean   @default(false)

  accounts    Account[]
  sessions    Session[]
  memberships Membership[]
  dashboardPreferences DashboardPreference[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ——— Platform / tenant ———

enum TenantStatus {
  PROVISIONING
  ACTIVE
  SUSPENDED
  CHURNED
}

enum TenantPlan {
  STARTER
  GROWTH
  ENTERPRISE
  ANCHOR
}

model Tenant {
  id               String       @id @default(cuid())
  name             String
  slug             String       @unique
  status           TenantStatus @default(PROVISIONING)
  plan             TenantPlan   @default(GROWTH)
  defaultCurrency  String       @default("NGN")
  defaultTimezone  String       @default("Africa/Lagos")
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  settings    TenantSettings?
  memberships Membership[]
  invitations Invitation[]
  pricingPlans ProjectPricingPlan[]
  projects    Project[]
  leads       Lead[]
  deals       Deal[]
  invoices    Invoice[]
  payments    PaymentRecord[]
  auditLogs   AuditLog[]
  goals       TenantGoal[]
  dashboardPreferences DashboardPreference[]
  campaigns   Campaign[]
  realtorPartners RealtorPartner[]
}

model TenantSettings {
  id                    String  @id @default(cuid())
  tenantId              String  @unique
  monthlyRevenueTarget  Decimal? @db.Decimal(18, 2)
  pipelineTarget        Decimal? @db.Decimal(18, 2)
  logoUrl               String?
  primaryColor          String?
  accentColor           String?
  moduleSales           Boolean @default(true)
  moduleFinance         Boolean @default(true)
  moduleMarketing       Boolean @default(true)
  moduleCommunity     Boolean @default(true)
  moduleRealtorPortal   Boolean @default(true)
  /// Extra nav modules per role beyond defaults, e.g. { "SALES_EXECUTIVE": ["MARKETING","FINANCE"] }
  roleModuleGrants      Json?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model TenantGoal {
  id             String   @id @default(cuid())
  tenantId       String
  label          String
  fiscalYearStart DateTime
  fiscalYearEnd   DateTime
  revenueTarget  Decimal? @db.Decimal(18, 2)
  pipelineTarget Decimal? @db.Decimal(18, 2)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, isActive])
}

model DashboardPreference {
  id         String   @id @default(cuid())
  tenantId   String
  userId     String
  roleView   String?
  widgetConfig Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
}

enum MembershipRole {
  ORG_ADMIN
  FINANCE_MANAGER
  SALES_MANAGER
  SALES_EXECUTIVE
  MARKETING_MANAGER
  COMMUNITY_MANAGER
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

model Membership {
  id        String           @id @default(cuid())
  tenantId  String
  userId    String
  role      MembershipRole
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
  @@index([tenantId])
}

model Invitation {
  id         String           @id @default(cuid())
  tenantId   String
  email      String
  role       MembershipRole
  token      String           @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime         @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([email])
}

// ——— Inventory & pipeline (Sprint 0 skeleton) ———

enum UnitStatus {
  AVAILABLE
  RESERVED
  SOLD
  UNDER_CONSTRUCTION
}

model Project {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  basePrice Decimal? @db.Decimal(18, 2)
  currency  String   @default("NGN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  units        Unit[]
  pricingPlans ProjectPricingPlan[]

  @@index([tenantId])
}

model ProjectPricingPlan {
  id                    String   @id @default(cuid())
  tenantId              String
  projectId             String
  name                  String
  price                 Decimal  @db.Decimal(18, 2)
  currency              String   @default("NGN")
  initialDeposit        Decimal? @db.Decimal(18, 2)
  paymentDurationMonths Int?
  billingCadence        String?
  metadata              Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  units   Unit[]

  @@index([tenantId])
  @@index([projectId])
}

model Unit {
  id        String     @id @default(cuid())
  tenantId  String
  projectId String
  pricingPlanId String?
  label     String
  unitType  String?
  status    UnitStatus @default(AVAILABLE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pricingPlan ProjectPricingPlan? @relation(fields: [pricingPlanId], references: [id], onDelete: SetNull)
  deal        Deal?

  @@index([tenantId])
  @@index([projectId])
  @@index([pricingPlanId])
}

enum LeadQuality {
  HOT
  WARM
  COLD
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  ENDED
}

model Campaign {
  id          String         @id @default(cuid())
  tenantId    String
  name        String
  code        String
  description String?
  status      CampaignStatus @default(ACTIVE)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leads  Lead[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model RealtorPartner {
  id              String   @id @default(cuid())
  tenantId        String
  displayName     String
  email           String?
  phone           String?
  company         String?
  territory       String?
  notes           String?  @db.Text
  isActive        Boolean  @default(true)
  portalTokenHash String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leads  Lead[]

  @@index([tenantId])
  @@index([tenantId, isActive])
}

model Lead {
  id              String      @id @default(cuid())
  tenantId        String
  assignedUserId  String?
  source          String?
  campaignName    String?
  campaignId      String?
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?
  utmContent      String?
  realtorPartnerId String?
  projectInterest String?
  budgetRange     String?
  quality         LeadQuality @default(WARM)
  name            String?
  email           String?
  phone           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign       Campaign?       @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  realtorPartner RealtorPartner? @relation(fields: [realtorPartnerId], references: [id], onDelete: SetNull)
  deals          Deal[]

  @@index([tenantId])
  @@index([tenantId, campaignId])
  @@index([tenantId, realtorPartnerId])
}

enum DealStage {
  NEW_LEAD
  CONTACTED
  QUALIFIED
  INSPECTION_BOOKED
  INSPECTION_COMPLETED
  NEGOTIATION
  RESERVATION_MADE
  CLOSED_WON
  CLOSED_LOST
}

enum FinanceReviewDecision {
  APPROVED
  REJECTED
}

model Deal {
  id             String     @id @default(cuid())
  tenantId       String
  leadId         String?
  unitId         String?    @unique
  assignedUserId String?
  stage          DealStage  @default(NEW_LEAD)
  value          Decimal?   @db.Decimal(18, 2)
  pendingFinance Boolean    @default(false)
  financeDecision        FinanceReviewDecision?
  financeReviewedAt      DateTime?
  financeReviewedByUserId String?
  financeReviewedByLabel String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead   Lead?  @relation(fields: [leadId], references: [id], onDelete: SetNull)
  unit   Unit?  @relation(fields: [unitId], references: [id], onDelete: SetNull)
  invoices Invoice[]

  @@index([tenantId])
  @@index([assignedUserId])
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  VOID
}

model Invoice {
  id                   String       @id @default(cuid())
  tenantId             String
  dealId               String?
  invoiceNumber        String
  title                String
  status               InvoiceStatus @default(SENT)
  amount               Decimal      @db.Decimal(18, 2)
  balanceDue           Decimal      @db.Decimal(18, 2)
  currency             String       @default("NGN")
  dueDate              DateTime?
  issuedAt             DateTime     @default(now())
  createdByUserId      String?
  createdByLabel       String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deal     Deal?           @relation(fields: [dealId], references: [id], onDelete: SetNull)
  payments PaymentRecord[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, status])
  @@index([dealId])
}

model PaymentRecord {
  id                String   @id @default(cuid())
  tenantId          String
  invoiceId         String
  amount            Decimal  @db.Decimal(18, 2)
  currency          String   @default("NGN")
  paidAt            DateTime
  method            String?
  reference         String?
  note              String?
  recordedByUserId  String?
  recordedByLabel   String?
  createdAt         DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId, paidAt])
  @@index([invoiceId])
}

model AuditLog {
  id           String   @id @default(cuid())
  tenantId     String
  actorUserId  String?
  actorLabel   String?
  module       String
  entityType   String
  entityId     String?
  action       String
  summary      String?
  metadata     Json?
  createdAt    DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, module])
  @@index([tenantId, entityType])
}
