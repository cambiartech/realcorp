// Realcorp — multi-tenant PropTech core schema (Sprint 0+)

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ——— Auth.js (Prisma adapter) ———

model User {
  id              String    @id @default(cuid())
  name            String?
  email           String?   @unique
  emailVerified   DateTime?
  image           String?
  passwordHash    String?
  isPlatformAdmin Boolean   @default(false)

  accounts             Account[]
  sessions             Session[]
  memberships          Membership[]
  dashboardPreferences DashboardPreference[]
  projectStakes        ProjectStakeholder[]
  propertyClients      PropertyClient[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ——— Platform / tenant ———

enum TenantStatus {
  PROVISIONING
  ACTIVE
  SUSPENDED
  CHURNED
}

enum TenantPlan {
  STARTER
  GROWTH
  ENTERPRISE
  ANCHOR
}

model Tenant {
  id              String       @id @default(cuid())
  name            String
  slug            String       @unique
  status          TenantStatus @default(PROVISIONING)
  plan            TenantPlan   @default(GROWTH)
  defaultCurrency String       @default("NGN")
  defaultTimezone String       @default("Africa/Lagos")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  settings             TenantSettings?
  memberships          Membership[]
  invitations          Invitation[]
  pricingPlans         ProjectPricingPlan[]
  projects             Project[]
  projectStakeholders  ProjectStakeholder[]
  leads                Lead[]
  deals                Deal[]
  invoices             Invoice[]
  salesReceipts        SalesReceipt[]
  payments             PaymentRecord[]
  auditLogs            AuditLog[]
  goals                TenantGoal[]
  dashboardPreferences DashboardPreference[]
  campaigns            Campaign[]
  realtorPartners      RealtorPartner[]
  shortletUnits        ShortletUnit[]
  shortletProperties   ShortletProperty[]
  shortletReservations ShortletReservation[]
  shortletPayments     ShortletPayment[]
  shortletFolioLines   ShortletFolioLine[]
  shortletServiceItems ShortletServiceItem[]
  shortletBusinessDays ShortletBusinessDay[]
  shortletGuests       ShortletGuest[]
  shortletCheckoutInspections ShortletCheckoutInspection[]
  activities           Activity[]
  whatsappMessages     WhatsAppMessage[]
  expenses             Expense[]
  financeVendors       FinanceVendor[]
  financeExpenseCategories FinanceExpenseCategory[]
  vendorBills          VendorBill[]
  vendorBillPayments   VendorBillPayment[]
  bankStatementImports BankStatementImport[]
  bankStatementRows    BankStatementRow[]
  employeeProfiles     EmployeeProfile[]
  hrAppraisalActions   HrAppraisalAction[]
  hrAppraisalCycles    HrAppraisalCycle[]
  hrAppraisals         HrAppraisal[]
  hrPayslipRuns        HrPayslipRun[]
  hrPayslips           HrPayslip[]
  hrDocuments          HrDocument[]
  hrPerformanceGoals   HrPerformanceGoal[]
  hrFormRequests       HrFormRequest[]
  hrOfferLetters       HrOfferLetter[]
  taskSpaces           TaskSpace[]
  taskProjects         TaskProject[]
  workTasks            WorkTask[]
  propertyClients      PropertyClient[]
  clientUnitLinks      ClientUnitLink[]
  clientDocuments      ClientDocument[]
  financeDocuments     FinanceDocument[]
  leadCaptureForms     LeadCaptureForm[]
  leadCaptureSessions  LeadCaptureFormSession[]
  leadCaptureEvents    LeadCaptureFormEvent[]
  platformErrorEvents  PlatformErrorEvent[]
}

model TenantSettings {
  id                   String   @id @default(cuid())
  tenantId             String   @unique
  monthlyRevenueTarget Decimal? @db.Decimal(18, 2)
  pipelineTarget       Decimal? @db.Decimal(18, 2)
  logoUrl              String?
  primaryColor         String?   @default("#1e3a5f")
  accentColor          String?   @default("#4f46e5")
  orgEmail             String?
  orgPhone             String?
  orgAddressLine       String?
  orgCity              String?
  orgState             String?
  orgCountry           String?   @default("Nigeria")
  moduleSales          Boolean  @default(true)
  moduleFinance        Boolean  @default(true)
  moduleMarketing      Boolean  @default(true)
  moduleCommunity      Boolean  @default(true)
  moduleRealtorPortal  Boolean  @default(true)
  moduleShortLets      Boolean  @default(false)
  moduleHr             Boolean  @default(false)
  moduleTasks          Boolean  @default(true)
  moduleClients        Boolean  @default(false)
  // Growth & channels (sellable add-ons)
  moduleWhatsApp       Boolean  @default(true)
  moduleListings       Boolean  @default(true)
  moduleInvestorPortal Boolean  @default(false)
  /// Extra nav modules per role beyond defaults, e.g. { "SALES_EXECUTIVE": ["MARKETING","FINANCE"] }
  roleModuleGrants     Json?
  orgDepartments       Json?

  // Meta Lead Ads integration
  metaVerifyToken      String?   // random string you enter in Meta webhook settings
  metaPageAccessToken  String?   // long-lived Page Access Token from Meta
  metaDefaultSource    String?   @default("Facebook")

  // Termii SMS integration
  termiiApiKey         String?
  termiiSenderId       String?   @default("Realcorp")

  // WhatsApp Cloud API integration (Meta)
  whatsappAccessToken  String?
  whatsappPhoneNumberId String?
  whatsappVerifyToken  String?
  // Realcorp Bot: auto-reply to inbound WhatsApp messages with listings menu
  whatsappBotEnabled   Boolean @default(false)

  // Cloudinary uploads (finance attachments)
  cloudinaryCloudName  String?
  cloudinaryApiKey     String?
  cloudinaryApiSecret  String?
  cloudinaryFolder     String?   @default("realcorp/finance")
  financeBankAccounts  Json?
  financePaymentModes  Json?
  financeCurrencies    Json?
  /// e.g. { expenseApprovalThreshold, firstReminderAfterDays, secondReminderAfterDays }
  financeControls      Json?

  // Short lets / PMS
  shortletCheckInTime        String  @default("14:00")
  shortletCheckOutTime       String  @default("12:00")
  shortletEodTime            String  @default("23:59")
  shortletCheckoutAlertHours Int     @default(2)
  shortletFinanceSync        Boolean @default(false)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model TenantGoal {
  id              String   @id @default(cuid())
  tenantId        String
  label           String
  fiscalYearStart DateTime
  fiscalYearEnd   DateTime
  revenueTarget   Decimal? @db.Decimal(18, 2)
  pipelineTarget  Decimal? @db.Decimal(18, 2)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, isActive])
}

model DashboardPreference {
  id           String   @id @default(cuid())
  tenantId     String
  userId       String
  roleView     String?
  widgetConfig Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
}

enum MembershipRole {
  ORG_ADMIN
  FINANCE_MANAGER
  HR_MANAGER
  SALES_MANAGER
  SALES_EXECUTIVE
  MARKETING_MANAGER
  COMMUNITY_MANAGER
  HOUSEKEEPING_MANAGER
  FNB_STAFF
  INVESTOR
  LISTING_OWNER
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

model Membership {
  id        String           @id @default(cuid())
  tenantId  String
  userId    String
  role      MembershipRole
  status    MembershipStatus @default(ACTIVE)
  /// Per-user module overrides: { "finance": "read", "marketing": "full" } — see membership-module-permissions.ts
  modulePermissions Json?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
  @@index([tenantId])
}

model Invitation {
  id         String         @id @default(cuid())
  tenantId   String
  email      String
  role       MembershipRole
  token      String         @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime       @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([email])
}

// ——— Inventory & pipeline (Sprint 0 skeleton) ———

enum UnitStatus {
  AVAILABLE
  RESERVED
  SOLD
  UNDER_CONSTRUCTION
}

model Project {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  basePrice Decimal? @db.Decimal(18, 2)
  currency  String   @default("NGN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Public listing layer (Explore API / widget / WhatsApp bot)
  isPublished        Boolean   @default(false)
  publishedAt        DateTime?
  listingDescription String?   @db.Text
  locationCity       String?
  locationState      String?
  locationAddress    String?
  coverImageUrl      String?
  galleryUrls        Json? // string[]
  amenities          Json? // string[]

  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  units        Unit[]
  pricingPlans ProjectPricingPlan[]
  stakeholders ProjectStakeholder[]

  @@index([tenantId])
  @@index([tenantId, isPublished])
}

enum StakeholderType {
  INVESTOR
  LISTING_OWNER
}

/// Links an investor / listing-owner user account to a project they have a stake in.
/// Drives the "My portfolio" portal: earnings = collections × (allocation ÷ total project allocation).
model ProjectStakeholder {
  id               String          @id @default(cuid())
  tenantId         String
  projectId        String
  userId           String
  type             StakeholderType
  sharePercent     Decimal         @default(100) @db.Decimal(5, 2)
  investmentAmount Decimal?        @db.Decimal(18, 2)
  notes            String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([tenantId, userId])
  @@index([projectId])
}

model ProjectPricingPlan {
  id                    String   @id @default(cuid())
  tenantId              String
  projectId             String
  name                  String
  price                 Decimal  @db.Decimal(18, 2)
  currency              String   @default("NGN")
  initialDeposit        Decimal? @db.Decimal(18, 2)
  paymentDurationMonths Int?
  billingCadence        String?
  metadata              Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  units   Unit[]
  clientLinks ClientUnitLink[]

  @@index([tenantId])
  @@index([projectId])
}

enum UnitPurpose {
  SALE
  SHORT_LET
  RENTAL
  HOSTEL
}

enum ActivityType {
  NOTE
  CALL
  EMAIL
  WHATSAPP
  MEETING
  TASK
}

enum ActivityStatus {
  DONE
  PENDING
  OVERDUE
}

model Activity {
  id              String         @id @default(cuid())
  tenantId        String
  entityType      String
  entityId        String
  type            ActivityType
  status          ActivityStatus @default(DONE)
  title           String
  body            String?        @db.Text
  dueAt           DateTime?
  completedAt     DateTime?
  createdByUserId String
  assignedUserId  String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, assignedUserId])
  @@index([tenantId, dueAt])
}

model WhatsAppMessage {
  id              String    @id @default(cuid())
  tenantId        String
  leadId          String?
  direction       String    // INBOUND | OUTBOUND
  waMessageId     String?
  fromPhone       String?
  toPhone         String?
  body            String    @db.Text
  // Meta delivery status for OUTBOUND messages: sent | delivered | read | failed
  status          String?
  statusUpdatedAt DateTime?
  timestamp       DateTime
  createdAt       DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead   Lead?  @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([tenantId, timestamp])
  @@index([tenantId, leadId, timestamp])
  @@index([waMessageId])
}

model Unit {
  id            String       @id @default(cuid())
  tenantId      String
  projectId     String
  pricingPlanId String?
  label         String
  purpose       UnitPurpose  @default(SALE)
  unitType      String?
  status        UnitStatus   @default(AVAILABLE)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  project      Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pricingPlan  ProjectPricingPlan? @relation(fields: [pricingPlanId], references: [id], onDelete: SetNull)
  deal         Deal?
  shortletUnit ShortletUnit?
  clientLinks  ClientUnitLink[]

  @@index([tenantId])
  @@index([projectId])
  @@index([pricingPlanId])
}

enum LeadQuality {
  HOT
  WARM
  COLD
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  ENDED
}

model Campaign {
  id          String         @id @default(cuid())
  tenantId    String
  name        String
  code        String
  description String?
  status      CampaignStatus @default(ACTIVE)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leads  Lead[]
  captureForms LeadCaptureForm[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model RealtorPartner {
  id              String   @id @default(cuid())
  tenantId        String
  displayName     String
  email           String?
  phone           String?
  company         String?
  territory       String?
  notes           String?  @db.Text
  isActive        Boolean  @default(true)
  portalTokenHash String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leads  Lead[]
  captureForms LeadCaptureForm[]

  @@index([tenantId])
  @@index([tenantId, isActive])
}

model Lead {
  id               String      @id @default(cuid())
  tenantId         String
  assignedUserId   String?
  source           String?
  campaignName     String?
  campaignId       String?
  utmSource        String?
  utmMedium        String?
  utmCampaign      String?
  utmContent       String?
  utmTerm          String?
  realtorPartnerId String?
  projectInterest  String?
  budgetRange      String?
  quality          LeadQuality @default(WARM)
  score            Int         @default(0)
  lastActivityAt   DateTime?
  name             String?
  email            String?
  phone            String?
  notes            String?     @db.Text
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign       Campaign?       @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  realtorPartner RealtorPartner? @relation(fields: [realtorPartnerId], references: [id], onDelete: SetNull)
  deals          Deal[]
  whatsappMessages WhatsAppMessage[]
  propertyClient PropertyClient?
  captureFormSession LeadCaptureFormSession?
  shortletReservations ShortletReservation[]

  @@index([tenantId])
  @@index([tenantId, score])
  @@index([tenantId, campaignId])
  @@index([tenantId, realtorPartnerId])
}

enum DealStage {
  NEW_LEAD
  CONTACTED
  QUALIFIED
  INSPECTION_BOOKED
  INSPECTION_COMPLETED
  NEGOTIATION
  RESERVATION_MADE
  CLOSED_WON
  CLOSED_LOST
}

enum FinanceReviewDecision {
  APPROVED
  REJECTED
}

model Deal {
  id                      String                 @id @default(cuid())
  tenantId                String
  leadId                  String?
  unitId                  String?                @unique
  assignedUserId          String?
  stage                   DealStage              @default(NEW_LEAD)
  value                   Decimal?               @db.Decimal(18, 2)
  pendingFinance          Boolean                @default(false)
  financeDecision         FinanceReviewDecision?
  financeReviewedAt       DateTime?
  financeReviewedByUserId String?
  financeReviewedByLabel  String?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead     Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  unit     Unit?     @relation(fields: [unitId], references: [id], onDelete: SetNull)
  invoices Invoice[]
  salesReceipts SalesReceipt[]
  propertyClient PropertyClient?

  @@index([tenantId])
  @@index([assignedUserId])
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  VOID
}

model Invoice {
  id              String        @id @default(cuid())
  tenantId        String
  dealId          String?
  invoiceNumber   String
  title           String
  status          InvoiceStatus @default(SENT)
  amount          Decimal       @db.Decimal(18, 2)
  balanceDue      Decimal       @db.Decimal(18, 2)
  currency        String        @default("NGN")
  department      String?
  dueDate         DateTime?
  issuedAt        DateTime      @default(now())
  pdfUrl          String?
  sentAt          DateTime?
  sentToEmail     String?
  createdByUserId String?
  createdByLabel  String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deal            Deal?            @relation(fields: [dealId], references: [id], onDelete: SetNull)
  payments        PaymentRecord[]
  financeDocument FinanceDocument?

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, status])
  @@index([dealId])
}

model PaymentRecord {
  id               String   @id @default(cuid())
  tenantId         String
  invoiceId        String?
  standaloneTitle  String?
  payerName        String?
  amount           Decimal  @db.Decimal(18, 2)
  currency         String   @default("NGN")
  department       String?
  paidAt           DateTime
  method           String?
  reference        String?
  note             String?
  attachmentUrl    String?
  attachmentName   String?
  attachmentPublicId String?
  recordedByUserId String?
  recordedByLabel  String?
  createdAt        DateTime @default(now())

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([tenantId, paidAt])
  @@index([invoiceId])
}

model Expense {
  id                 String   @id @default(cuid())
  tenantId           String
  projectId          String?
  unitId             String?
  category           String
  department         String?
  vendorName         String?
  amount             Decimal  @db.Decimal(18, 2)
  currency           String   @default("NGN")
  expenseDate        DateTime
  paidThroughAccount String?
  reference          String?
  note               String?
  attachmentUrl      String?
  attachmentName     String?
  attachmentPublicId String?
  createdByUserId    String?
  createdByLabel     String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, expenseDate])
  @@index([tenantId, category])
}

model FinanceVendor {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId, name])
}

model FinanceExpenseCategory {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId, name])
}

enum VendorBillStatus {
  OPEN
  PARTIAL
  PAID
  VOID
}

enum VendorBillRecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

model VendorBill {
  id                  String                         @id @default(cuid())
  tenantId            String
  projectId           String?
  unitId              String?
  billNumber          String
  vendorName          String
  title               String
  status              VendorBillStatus               @default(OPEN)
  amount              Decimal                        @db.Decimal(18, 2)
  balanceDue          Decimal                        @db.Decimal(18, 2)
  currency            String                         @default("NGN")
  department          String?
  dueDate             DateTime?
  issuedAt            DateTime                       @default(now())
  note                String?
  isRecurring         Boolean                        @default(false)
  recurrenceFrequency VendorBillRecurrenceFrequency?
  recurrenceSeriesId  String?
  recurrenceIndex     Int?
  createdByUserId     String?
  createdByLabel      String?
  createdAt           DateTime                       @default(now())
  updatedAt           DateTime                       @updatedAt

  tenant   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payments VendorBillPayment[]

  @@unique([tenantId, billNumber])
  @@index([tenantId, status])
  @@index([tenantId, dueDate])
  @@index([tenantId, recurrenceSeriesId])
}

model VendorBillPayment {
  id                 String   @id @default(cuid())
  tenantId           String
  billId             String
  amount             Decimal  @db.Decimal(18, 2)
  currency           String   @default("NGN")
  paidAt             DateTime
  method             String?
  reference          String?
  paidThroughAccount String?
  recordedByUserId   String?
  recordedByLabel    String?
  createdAt          DateTime @default(now())

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bill   VendorBill @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([tenantId, paidAt])
  @@index([billId])
}

model SalesReceipt {
  id                 String   @id @default(cuid())
  tenantId           String
  dealId             String?
  receiptNumber      String
  title              String
  customerName       String?
  amount             Decimal  @db.Decimal(18, 2)
  currency           String   @default("NGN")
  paymentMode        String?
  depositAccount     String?
  reference          String?
  note               String?
  status             String   @default("RECORDED")
  pdfUrl             String?
  sentAt             DateTime?
  sentToEmail        String?
  issuedAt           DateTime @default(now())
  createdByUserId    String?
  createdByLabel     String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deal            Deal?            @relation(fields: [dealId], references: [id], onDelete: SetNull)
  financeDocument FinanceDocument?
  shortletPayments     ShortletPayment[]
  shortletBusinessDays ShortletBusinessDay[]

  @@unique([tenantId, receiptNumber])
  @@index([tenantId, issuedAt])
  @@index([tenantId, dealId])
}

enum FinanceDocumentCategory {
  RECEIPT
  INVOICE
  OTHER
}

model FinanceDocument {
  id               String                  @id @default(cuid())
  tenantId         String
  category         FinanceDocumentCategory @default(RECEIPT)
  title            String
  fileUrl          String
  fileName         String?
  salesReceiptId   String?                 @unique
  invoiceId        String?                 @unique
  uploadedByUserId String?
  uploadedByLabel  String?
  createdAt        DateTime                @default(now())

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  salesReceipt SalesReceipt? @relation(fields: [salesReceiptId], references: [id], onDelete: SetNull)
  invoice      Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([tenantId, category])
  @@index([tenantId, createdAt])
}

enum BankMatchStatus {
  UNMATCHED
  MATCHED
  EXCEPTION
}

model BankStatementImport {
  id              String             @id @default(cuid())
  tenantId        String
  sourceName      String
  importedByUserId String?
  importedByLabel String?
  importedAt      DateTime           @default(now())
  finalizedAt     DateTime?
  finalizedByUserId String?
  finalizedByLabel String?
  createdAt       DateTime           @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rows   BankStatementRow[]

  @@index([tenantId, importedAt])
}

model BankStatementRow {
  id                String          @id @default(cuid())
  tenantId          String
  importId          String
  postedAt          DateTime?
  description       String?
  reference         String?
  debit             Decimal         @default(0) @db.Decimal(18, 2)
  credit            Decimal         @default(0) @db.Decimal(18, 2)
  amountAbs         Decimal         @db.Decimal(18, 2)
  direction         String
  matchStatus       BankMatchStatus @default(UNMATCHED)
  matchedEntityType String?
  matchedEntityId   String?
  matchedAt         DateTime?
  matchedByUserId   String?
  matchedByLabel    String?
  exceptionReason   String?
  reconciliationNote String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  tenant Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  import BankStatementImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([tenantId, postedAt])
  @@index([tenantId, matchStatus, createdAt])
  @@index([tenantId, matchedEntityType, matchedEntityId])
  @@index([importId])
}

enum ShortletHousekeepingStatus {
  VACANT_CLEAN
  VACANT_DIRTY
  OCCUPIED
  OUT_OF_ORDER
}

enum ShortletReservationStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
  RESERVED
}

enum ShortletGuestType {
  INDIVIDUAL
  CORPORATE
}

enum ShortletInspectionStatus {
  AWAITING_INSPECTION
  PASSED
  FAILED
  WAIVED
}

enum ShortletInspectionCondition {
  GOOD
  DAMAGES_FOUND
  MAINTENANCE_REQUIRED
}

enum ShortletReservationSource {
  DIRECT
  WALK_IN
  EXPLORE
  PHONE
  OTA
}

enum ShortletFolioDepartment {
  ROOM
  FNB
  LAUNDRY
  LOUNGE
  GYM
  OTHER
}

enum ShortletListingStatus {
  AVAILABLE
  UNAVAILABLE
  MAINTENANCE
}

model ShortletProperty {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  locationCode String?
  address   String?
  city      String?
  state     String?
  country   String?  @default("Nigeria")
  phone     String?
  email     String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  units  ShortletUnit[]
  reservations ShortletReservation[]

  @@index([tenantId, isActive])
  @@index([tenantId, sortOrder])
}

model ShortletUnit {
  id                  String                     @id @default(cuid())
  tenantId            String
  propertyId          String?
  projectUnitId       String?                    @unique
  name                String
  location            String?
  floor               String?
  roomLayout          String?
  sizeSqFt            Int?
  maxOccupancy        Int?
  description         String?                    @db.Text
  amenities           Json?
  listingStatus       ShortletListingStatus      @default(AVAILABLE)
  isActive            Boolean                    @default(true)
  nightlyRate         Decimal                    @db.Decimal(18, 2)
  cleaningFee         Decimal?                   @db.Decimal(18, 2)
  cautionFee          Decimal?                   @db.Decimal(18, 2)
  currency            String                     @default("NGN")
  housekeepingStatus  ShortletHousekeepingStatus @default(VACANT_CLEAN)
  activeReservationId String?                    @unique
  assignedToUserId    String?
  assignedToLabel     String?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  tenant            Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property          ShortletProperty?     @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  projectUnit       Unit?                 @relation(fields: [projectUnitId], references: [id], onDelete: SetNull)
  activeReservation ShortletReservation?  @relation("ActiveShortletReservation", fields: [activeReservationId], references: [id], onDelete: SetNull)
  reservations      ShortletReservation[]
  checkoutInspections ShortletCheckoutInspection[]

  @@index([tenantId, housekeepingStatus])
  @@index([tenantId, propertyId])
  @@index([tenantId, createdAt])
}

model ShortletGuest {
  id               String           @id @default(cuid())
  tenantId         String
  firstName        String
  lastName         String?
  fullName         String
  email            String?
  phone            String?
  guestType        ShortletGuestType @default(INDIVIDUAL)
  idType           String?
  idNumber         String?
  idDocumentUrl    String?
  addressLine      String?
  city             String?
  state            String?
  country          String?          @default("Nigeria")
  notes            String?          @db.Text
  propertyClientId String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  propertyClient PropertyClient?     @relation(fields: [propertyClientId], references: [id], onDelete: SetNull)
  reservations   ShortletReservation[]

  @@index([tenantId, fullName])
  @@index([tenantId, email])
  @@index([tenantId, phone])
}

model ShortletReservation {
  id              String                    @id @default(cuid())
  tenantId        String
  unitId          String?
  propertyId      String?
  guestId         String?
  guestClientId   String?
  channelLeadId   String?
  bookingNumber   String?
  guestName       String
  guestEmail      String?
  guestPhone      String?
  checkIn         DateTime
  checkOut        DateTime
  nights          Int
  totalAmount     Decimal                   @db.Decimal(18, 2)
  amountPaid      Decimal                   @default(0) @db.Decimal(18, 2)
  balanceDue      Decimal                   @db.Decimal(18, 2)
  cautionFee      Decimal?                  @db.Decimal(18, 2)
  cautionFeePaid  Decimal                   @default(0) @db.Decimal(18, 2)
  currency        String                    @default("NGN")
  status          ShortletReservationStatus @default(PENDING)
  source          ShortletReservationSource @default(DIRECT)
  isWalkIn        Boolean                   @default(false)
  notes           String?
  createdByUserId String?
  createdByLabel  String?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit         ShortletUnit?       @relation(fields: [unitId], references: [id], onDelete: SetNull)
  property     ShortletProperty?   @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  guest        ShortletGuest?      @relation(fields: [guestId], references: [id], onDelete: SetNull)
  guestClient  PropertyClient?     @relation(fields: [guestClientId], references: [id], onDelete: SetNull)
  channelLead  Lead?               @relation(fields: [channelLeadId], references: [id], onDelete: SetNull)
  activeOnUnit ShortletUnit?       @relation("ActiveShortletReservation")
  payments     ShortletPayment[]
  folioLines   ShortletFolioLine[]
  checkoutInspection ShortletCheckoutInspection?

  @@index([tenantId, status])
  @@index([tenantId, checkIn, checkOut])
  @@index([tenantId, guestId])
  @@index([tenantId, propertyId])
  @@index([tenantId, guestClientId])
  @@index([tenantId, channelLeadId])
  @@index([tenantId, bookingNumber])
  @@index([unitId, status])
}

model ShortletCheckoutInspection {
  id                           String                      @id @default(cuid())
  tenantId                     String
  reservationId                String                      @unique
  unitId                       String
  status                       ShortletInspectionStatus    @default(AWAITING_INSPECTION)
  condition                    ShortletInspectionCondition?
  damageNotes                  String?                     @db.Text
  cautionFeeAmount             Decimal?                    @db.Decimal(18, 2)
  cautionRefunded              Decimal?                    @db.Decimal(18, 2)
  cautionDeduction             Decimal?                    @db.Decimal(18, 2)
  inspectedAt                  DateTime?
  inspectedByUserId            String?
  inspectedByLabel             String?
  housekeepingCompletedAt      DateTime?
  housekeepingCompletedByLabel String?
  photoUrls                    Json?
  createdAt                    DateTime                    @default(now())
  updatedAt                    DateTime                    @updatedAt

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reservation ShortletReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  unit        ShortletUnit        @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, unitId])
}

model ShortletPayment {
  id               String   @id @default(cuid())
  tenantId         String
  reservationId    String
  financeReceiptId String?
  amount           Decimal  @db.Decimal(18, 2)
  currency         String   @default("NGN")
  paidAt           DateTime
  method           String?
  reference        String?
  note             String?
  recordedByUserId String?
  recordedByLabel  String?
  createdAt        DateTime @default(now())

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reservation ShortletReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  financeReceipt SalesReceipt?    @relation(fields: [financeReceiptId], references: [id], onDelete: SetNull)

  @@index([tenantId, paidAt])
  @@index([reservationId])
  @@index([financeReceiptId])
}

model ShortletServiceItem {
  id        String                  @id @default(cuid())
  tenantId  String
  department ShortletFolioDepartment
  name      String
  price     Decimal                 @db.Decimal(18, 2)
  currency  String                  @default("NGN")
  active    Boolean                 @default(true)
  sortOrder Int                     @default(0)
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt

  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  folioLines ShortletFolioLine[]

  @@index([tenantId, department, active])
}

model ShortletFolioLine {
  id               String                  @id @default(cuid())
  tenantId         String
  reservationId    String
  serviceItemId    String?
  department       ShortletFolioDepartment
  description      String
  quantity         Int                     @default(1)
  unitPrice        Decimal                 @db.Decimal(18, 2)
  amount           Decimal                 @db.Decimal(18, 2)
  currency         String                  @default("NGN")
  postedAt         DateTime                @default(now())
  postedByUserId   String?
  postedByLabel    String?
  createdAt        DateTime                @default(now())

  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reservation ShortletReservation  @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  serviceItem ShortletServiceItem? @relation(fields: [serviceItemId], references: [id], onDelete: SetNull)

  @@index([tenantId, postedAt])
  @@index([reservationId])
}

model ShortletBusinessDay {
  id               String   @id @default(cuid())
  tenantId         String
  businessDate     DateTime @db.Date
  closedAt         DateTime
  closedByUserId   String?
  closedByLabel    String?
  financeReceiptId String?
  snapshot         Json?
  createdAt        DateTime @default(now())

  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  financeReceipt SalesReceipt? @relation(fields: [financeReceiptId], references: [id], onDelete: SetNull)

  @@unique([tenantId, businessDate])
  @@index([tenantId, closedAt])
  @@index([financeReceiptId])
}

model AuditLog {
  id          String   @id @default(cuid())
  tenantId    String
  actorUserId String?
  actorLabel  String?
  module      String
  entityType  String
  entityId    String?
  action      String
  summary     String?
  metadata    Json?
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, module])
  @@index([tenantId, entityType])
}

model PlatformErrorEvent {
  id         String   @id @default(cuid())
  digest     String
  name       String?
  message    String?
  stack      String?
  routePath  String?
  requestUrl String?
  tenantSlug String?
  tenantId   String?
  userId     String?
  userEmail  String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([digest, createdAt])
  @@index([tenantId, createdAt])
  @@index([tenantSlug, createdAt])
}

// ——— Human Resources (People management) ———

enum EmployeeProfileStatus {
  DRAFT
  ACTIVE
  EXITED
}

enum HrDocumentCategory {
  BIODATA
  BANK_FORM
  OFFER_LETTER
  NDA
  GUARANTOR
  JOB_DESCRIPTION
  CONTRACT
  PAYSLIP
  APPRAISAL
  OTHER
}

enum HrAppraisalCycleType {
  MONTHLY
  YEARLY
}

enum HrAppraisalCycleStatus {
  OPEN
  CLOSED
}

enum HrAppraisalStatus {
  DRAFT
  SELF_SUBMITTED
  REVIEWED
}

enum HrPayslipRunStatus {
  DRAFT
  FINALIZED
}

enum HrPayslipPaymentStatus {
  PENDING
  PAID
}

enum HrFormType {
  BIODATA
  BANK_FORM
  GUARANTOR
  HEALTH
}

enum HrFormDeliveryMode {
  ONLINE_FILL
  PRINT_UPLOAD
  BOTH
}

enum HrFormRequestStatus {
  PENDING
  SUBMITTED
  APPROVED
  CANCELLED
  EXPIRED
}

enum HrOfferLetterStatus {
  DRAFT
  AWAITING_SIGNATURE
  SIGNED
}

model HrOfferLetter {
  id                  String               @id @default(cuid())
  tenantId            String
  employeeProfileId   String               @unique
  bodyHtml            String               @db.Text
  status              HrOfferLetterStatus  @default(DRAFT)
  token               String?              @unique
  tokenExpiresAt      DateTime?
  candidateSignature  String?              @db.Text
  candidateSignedAt   DateTime?
  signedSnapshotUrl   String?
  lastEditedByUserId  String?
  lastEditedByLabel   String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  profile EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([token])
}

model EmployeeProfile {
  id               String                @id @default(cuid())
  tenantId         String
  userId           String
  employeeNumber   String?
  status           EmployeeProfileStatus @default(DRAFT)
  fullName         String?
  gender           String?
  dateOfBirth      DateTime?
  maritalStatus    String?
  nationality      String?
  phoneMobile      String?
  workEmail        String?
  addressStreet    String?
  addressCity      String?
  addressState     String?
  position         String?
  department       String?
  dateOfJoining    DateTime?
  reportingToLabel String?
  employmentType   String?
  workSchedule     String?
  paygroupName     String?
  grossMonthly     Decimal?              @db.Decimal(18, 2)
  payeeTaxMonthly  Decimal?              @db.Decimal(18, 2)
  basicPercent     Decimal               @default(30) @db.Decimal(5, 2)
  housingPercent   Decimal               @default(20) @db.Decimal(5, 2)
  transportPercent Decimal               @default(15) @db.Decimal(5, 2)
  otherPercent     Decimal               @default(35) @db.Decimal(5, 2)
  emergencyContact Json?
  education        Json?
  nextOfKin        Json?
  healthInfo       Json?
  additionalInfo   Json?
  bankAccount      Json?
  guarantorInfo    Json?
  hrNotes          String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  documents        HrDocument[]
  appraisals       HrAppraisal[]
  payslips         HrPayslip[]
  performanceGoals HrPerformanceGoal[]
  formRequests     HrFormRequest[]
  offerLetter      HrOfferLetter?

  @@unique([tenantId, userId])
  @@index([tenantId, status])
  @@index([tenantId, department])
}

model HrDocument {
  id                String             @id @default(cuid())
  tenantId          String
  employeeProfileId String
  category          HrDocumentCategory @default(OTHER)
  title             String
  fileUrl           String
  fileName          String?
  uploadedByUserId  String?
  uploadedByLabel   String?
  createdAt         DateTime           @default(now())

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  profile EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)

  @@index([tenantId, employeeProfileId])
  @@index([tenantId, category])
}

model HrAppraisalAction {
  id          String               @id @default(cuid())
  tenantId    String
  title       String
  description String?
  cycleType   HrAppraisalCycleType
  sortOrder   Int                  @default(0)
  isActive    Boolean              @default(true)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, cycleType, isActive])
}

model HrAppraisalCycle {
  id          String                 @id @default(cuid())
  tenantId    String
  cycleType   HrAppraisalCycleType
  periodLabel String
  status      HrAppraisalCycleStatus @default(OPEN)
  dueDate     DateTime?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appraisals HrAppraisal[]

  @@unique([tenantId, cycleType, periodLabel])
  @@index([tenantId, status])
}

model HrAppraisal {
  id                String            @id @default(cuid())
  tenantId          String
  cycleId           String
  employeeProfileId String
  status            HrAppraisalStatus @default(DRAFT)
  actionScores      Json?
  selfNotes         String?
  managerNotes      String?
  overallRating     Int?
  reviewerUserId    String?
  reviewerLabel     String?
  reviewedAt        DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cycle   HrAppraisalCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  profile EmployeeProfile  @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)

  @@unique([cycleId, employeeProfileId])
  @@index([tenantId, employeeProfileId])
}

model HrPayslipRun {
  id        String             @id @default(cuid())
  tenantId  String
  year      Int
  month     Int
  label     String
  status    HrPayslipRunStatus   @default(DRAFT)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payslips HrPayslip[]

  @@unique([tenantId, year, month])
  @@index([tenantId, status])
}

model HrPayslip {
  id                String   @id @default(cuid())
  tenantId          String
  runId             String
  employeeProfileId String
  currency          String   @default("NGN")
  grossPay          Decimal  @db.Decimal(18, 2)
  payeeTax          Decimal  @db.Decimal(18, 2)
  pensionDeduction  Decimal  @db.Decimal(18, 2)
  otherDeductions   Decimal  @default(0) @db.Decimal(18, 2)
  netPay            Decimal  @db.Decimal(18, 2)
  earningsBreakdown Json
  deductionsBreakdown Json
  paymentStatus     HrPayslipPaymentStatus @default(PENDING)
  paidAt            DateTime?
  paymentReference  String?
  paidByLabel       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  run     HrPayslipRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  profile EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)

  @@unique([runId, employeeProfileId])
  @@index([tenantId, employeeProfileId])
  @@index([tenantId, paymentStatus])
}

model HrPerformanceGoal {
  id                String    @id @default(cuid())
  tenantId          String
  employeeProfileId String
  title             String
  description       String?
  targetValue       String?
  progressPercent   Int       @default(0)
  dueDate           DateTime?
  status            String    @default("IN_PROGRESS")
  createdByLabel    String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  profile EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)

  @@index([tenantId, employeeProfileId])
}

model HrFormRequest {
  id                String               @id @default(cuid())
  tenantId          String
  employeeProfileId String?
  recipientName     String?
  recipientEmail    String?
  formType          HrFormType
  deliveryMode      HrFormDeliveryMode   @default(ONLINE_FILL)
  status            HrFormRequestStatus  @default(PENDING)
  token             String               @unique
  /// When HR sends multiple forms at once, all share this token → one master link.
  bundleToken       String?
  hrNote            String?
  submittedPayload  Json?
  submittedFileUrl  String?
  submittedFileName String?
  expiresAt         DateTime
  submittedAt       DateTime?
  approvedAt        DateTime?
  approvedByUserId  String?
  approvedByLabel   String?
  createdByUserId   String?
  createdByLabel    String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  profile EmployeeProfile? @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)

  @@index([tenantId, employeeProfileId])
  @@index([tenantId, status])
  @@index([token])
  @@index([bundleToken])
}

// ——— Nigeria reference geography (synced from open dataset, shared platform-wide) ———

model NigeriaStateRef {
  id          String          @id @default(cuid())
  name        String          @unique
  slug        String          @unique
  lgaCount    Int             @default(0)
  sourceUrl   String?
  syncedAt    DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  lgas        NigeriaLgaRef[]
}

model NigeriaLgaRef {
  id      String          @id @default(cuid())
  stateId String
  name    String
  slug    String
  state   NigeriaStateRef @relation(fields: [stateId], references: [id], onDelete: Cascade)

  @@unique([stateId, slug])
  @@index([stateId])
  @@index([name])
}

// ---------------------------------------------------------------------------
// Tasks — org-wide work (Notion-style teamspaces, projects, kanban)
// Separate from CRM Activity (sales follow-ups on leads/deals).
// ---------------------------------------------------------------------------

enum WorkTaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  CANCELLED
}

enum WorkTaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskProjectStatus {
  ACTIVE
  ARCHIVED
}

/// Teamspace — e.g. Company HQ, Product, Engineering, People
model TaskSpace {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  slug        String
  description String?
  color       String?  @default("#6366f1")
  sortOrder   Int      @default(0)
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projects TaskProject[]
  tasks    WorkTask[]

  @@unique([tenantId, slug])
  @@index([tenantId, sortOrder])
}

/// Work project within a space — roadmap, sprint, appraisal cycle container
model TaskProject {
  id          String            @id @default(cuid())
  tenantId    String
  spaceId     String
  name        String
  description String?
  status      TaskProjectStatus @default(ACTIVE)
  sprintLabel String?
  iconEmoji   String?
  dueDate     DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  tenant Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  space  TaskSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  tasks  WorkTask[]

  @@index([tenantId, spaceId])
  @@index([tenantId, status])
}

model WorkTask {
  id              String           @id @default(cuid())
  tenantId        String
  spaceId         String?
  projectId       String?
  title           String
  description     String?          @db.Text
  status          WorkTaskStatus   @default(TODO)
  priority        WorkTaskPriority @default(MEDIUM)
  assigneeUserId  String?
  createdByUserId String
  dueDate         DateTime?
  completedAt     DateTime?
  sprintLabel     String?
  sortOrder       Int              @default(0)
  /// Future HR/CRM links: HR_APPRAISAL | HR_GOAL | LEAD | DEAL
  linkedEntityType String?
  linkedEntityId   String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  tenant  Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  space   TaskSpace?   @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  project TaskProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([tenantId, assigneeUserId])
  @@index([tenantId, spaceId])
  @@index([tenantId, projectId])
  @@index([tenantId, linkedEntityType, linkedEntityId])
}

// ——— Clients (property owners / investors) ———

enum PropertyClientStatus {
  PROSPECT
  ACTIVE
  FORMER
}

enum ClientUnitLinkRole {
  OWNER
  CO_OWNER
  TENANT
  INVESTOR
  BENEFICIARY
}

enum ClientDocumentCategory {
  ID
  PURCHASE_AGREEMENT
  ALLOCATION_LETTER
  RECEIPT
  DEED
  TENANCY
  CORRESPONDENCE
  OTHER
}

model PropertyClient {
  id             String               @id @default(cuid())
  tenantId       String
  leadId         String?              @unique
  dealId         String?              @unique
  fullName       String
  email          String?
  phone          String?
  alternatePhone String?
  addressLine    String?
  city           String?
  state          String?
  country        String?              @default("Nigeria")
  status         PropertyClientStatus @default(PROSPECT)
  notes          String?              @db.Text
  assignedUserId String?
  userId         String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead      Lead?            @relation(fields: [leadId], references: [id], onDelete: SetNull)
  deal      Deal?            @relation(fields: [dealId], references: [id], onDelete: SetNull)
  portalUser User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  unitLinks ClientUnitLink[]
  documents ClientDocument[]
  shortletReservations ShortletReservation[]
  shortletGuests       ShortletGuest[]

  @@index([tenantId, status])
  @@index([tenantId, fullName])
  @@index([tenantId, email])
  @@index([userId])
}

model ClientUnitLink {
  id            String             @id @default(cuid())
  tenantId      String
  clientId      String
  unitId        String
  pricingPlanId String?
  role          ClientUnitLinkRole @default(OWNER)
  startDate     DateTime?
  endDate       DateTime?
  isPrimary     Boolean            @default(true)
  notes         String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client      PropertyClient      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  unit        Unit                @relation(fields: [unitId], references: [id], onDelete: Cascade)
  pricingPlan ProjectPricingPlan? @relation(fields: [pricingPlanId], references: [id], onDelete: SetNull)

  @@unique([tenantId, clientId, unitId])
  @@index([tenantId, clientId])
  @@index([tenantId, unitId])
}

model ClientDocument {
  id               String                 @id @default(cuid())
  tenantId         String
  clientId         String
  category         ClientDocumentCategory @default(OTHER)
  title            String
  fileUrl          String
  fileName         String?
  uploadedByUserId String?
  uploadedByLabel  String?
  createdAt        DateTime               @default(now())

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client PropertyClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([tenantId, clientId])
  @@index([tenantId, category])
}

// ——— Lead capture forms (lead magnets) ———

enum LeadCaptureFormStatus {
  DRAFT
  ACTIVE
  PAUSED
}

enum LeadCaptureSessionStatus {
  VIEWED
  STARTED
  PARTIAL
  COMPLETED
  ABANDONED
}

enum LeadCaptureFormEventType {
  VIEW
  START
  FIELD_BLUR
  PARTIAL_SAVE
  SUBMIT
  ABANDON
}

model LeadCaptureForm {
  id               String                @id @default(cuid())
  tenantId         String
  name             String
  slug             String
  title            String
  description      String?               @db.Text
  status           LeadCaptureFormStatus @default(DRAFT)
  fields           Json
  thankYouMessage  String?               @db.Text
  redirectUrl      String?
  defaultSource    String?               @default("Lead Form")
  campaignId       String?
  assignedUserId   String?
  realtorPartnerId String?
  createdByUserId  String?
  viewCount        Int                   @default(0)
  startCount       Int                   @default(0)
  partialCount     Int                   @default(0)
  submitCount       Int                   @default(0)
  autoWhatsAppEnabled Boolean             @default(false)
  autoWhatsAppMessage String?             @db.Text
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  tenant         Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign       Campaign?                @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  realtorPartner RealtorPartner?          @relation(fields: [realtorPartnerId], references: [id], onDelete: SetNull)
  sessions       LeadCaptureFormSession[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([tenantId, status])
}

model LeadCaptureFormSession {
  id               String                   @id @default(cuid())
  tenantId         String
  formId           String
  sessionToken     String
  status           LeadCaptureSessionStatus @default(VIEWED)
  utmSource        String?
  utmMedium        String?
  utmCampaign      String?
  utmContent       String?
  utmTerm          String?
  referrer         String?
  landingUrl       String?
  sharerUserId     String?
  realtorPartnerId String?
  ipCountry        String?
  ipRegion         String?
  ipCity           String?
  timezone         String?
  localHour        Int?
  deviceType       String?
  browser          String?
  os               String?
  userAgent        String?                  @db.Text
  fieldsCompleted  Json?
  completionPct    Int                      @default(0)
  lastFieldKey     String?
  leadId           String?                  @unique
  startedAt        DateTime?
  completedAt      DateTime?
  lastActivityAt   DateTime                 @default(now())
  createdAt        DateTime                 @default(now())

  tenant Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  form   LeadCaptureForm    @relation(fields: [formId], references: [id], onDelete: Cascade)
  lead   Lead?              @relation(fields: [leadId], references: [id], onDelete: SetNull)
  events LeadCaptureFormEvent[]

  @@unique([formId, sessionToken])
  @@index([tenantId, formId])
  @@index([formId, status])
}

model LeadCaptureFormEvent {
  id        String                   @id @default(cuid())
  tenantId  String
  formId    String
  sessionId String
  type      LeadCaptureFormEventType
  fieldKey  String?
  payload   Json?
  createdAt DateTime                 @default(now())

  tenant  Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  session LeadCaptureFormSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([formId, type])
  @@index([tenantId, formId])
}
